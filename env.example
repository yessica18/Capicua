# 1. SUPABASE (Base de Datos Relacional, Autenticación y Storage)
# Obtén estas credenciales en tu panel de Supabase: Project Settings -> API
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. INTELIGENCIA ARTIFICIAL DE CAPI (Google Gemini o Proveedor OpenAI/Claude)
# Recomendado: Google Gemini API (gratuita / bajo costo para educación)
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# 3. PASARELA DE PAGOS WOMPI (Colombia: Nequi, PSE, Tarjetas)
# Obtén tus llaves en https://comercios.wompi.co/
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."
WOMPI_EVENTS_SECRET="test_events_..."

# 4. PASARELA DE PAGOS STRIPE (Internacional)
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 5. CONFIGURACIÓN DEL SISTEMA
APP_URL="https://capicua.netlify.app"
NODE_ENV="development"
